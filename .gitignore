# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Environment variables (API keys etc)
.env
.env.local

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code per-checkout overrides (committed settings.json is fine; .local is personal)
.claude/settings.local.json

# Project outputs that shouldn't be committed raw
# (curated transcripts in results/ ARE committed; only scratch goes here)
scratch/
*.log

# LLM-capability axis (7-game sweep): commit each game's transcript.jsonl
# (irreplaceable source of truth) but NOT its dashboard, which re-renders for
# free from the transcript (python -m diplomacy_a2a render <run-dir>). To publish
# a showcase game's dashboard, force-add past this rule: git add -f <id>/dashboard
results/model-capability/*/dashboard/

# In-progress communications kept private until published (the repo is public).
# Move a file up to communications/<medium>/ to make it visible.
communications/drafts/

# Funding/grant applications: private (contain strategy + cost detail).
communications/anthropic/

# LinkedIn posts: kept private (personal account, drafted before posting).
communications/linkedin/

# Third-party reference papers stored locally (copyright; not ours to redistribute).
communications/references/

# Optional agent-prompt dumps (large, redundant) — opt-in via log_prompts.
# The canonical run's prompts.jsonl is committed on purpose (force-added past
# this rule) as a transparency artifact; this just guards against accidentally
# committing dumps from a full experiment grid.
prompts.jsonl
