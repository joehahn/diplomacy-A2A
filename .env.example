# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored — your real key will not be committed.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed for cheap-model playtests via the OpenRouter gateway
# (Gemini, DeepSeek, etc.). Leave unset for normal Anthropic-only runs.
OPENROUTER_API_KEY=sk-or-...
